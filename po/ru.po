#: speedgtk.py:3143
msgid "Details"
msgstr "Подробности"

#: speedgtk.py:3149
msgid "speedtest error"
msgstr "Ошибка speedtest"

#: speedgtk.py:3150
msgid "Close"
msgstr "Закрыть"

#: speedgtk.py:3194
msgid ""
"Usage: speedgtk.py [options]\n"
"\n"
"  --plain     start with the classic, label-only GNOME interface\n"
"  --accent    use the theme accent color instead of Ookla's colors\n"
"  -h, --help  show this message\n"
"\n"
"Both options apply to this run only; the persistent settings live in\n"
"Preferences (Ctrl+,). Test history: Ctrl+H.\n"
msgstr ""
"Использование: speedgtk.py [параметры]\n"
"\n"
"  --plain     запустить классический интерфейс GNOME, только текст\n"
"  --accent    использовать акцентный цвет темы вместо цветов Ookla\n"
"  -h, --help  показать это сообщение\n"
"\n"
"Оба параметра действуют только для этого запуска; постоянные настройки —\n"
"в Параметрах (Ctrl+,). История тестов: Ctrl+H.\n"

