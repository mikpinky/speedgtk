msgstr "El ID de servidor manual debe ser un número"

#: speedgtk.py:2817
msgid "Cancelling…"
msgstr "Cancelando…"

#: speedgtk.py:2841
msgid "Cannot start speedtest"
msgstr "No se puede iniciar speedtest"

#: speedgtk.py:2852
msgid "Repeat test"
msgstr "Repetir prueba"

