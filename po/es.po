msgstr "Ordenar por fecha (predeterminado)"

#: speedgtk.py:102
msgid "Best download"
msgstr "Mejor descarga"

#: speedgtk.py:103
msgid "Best upload"
msgstr "Mejor subida"

#: speedgtk.py:104
msgid "Best ping"
msgstr "Mejor ping"

#: speedgtk.py:105
msgid "Best overall"
msgstr "Mejor resultado general"

#: speedgtk.py:109 speedgtk.py:249
msgid "Same as the system"
msgstr "Igual que el sistema"

#: speedgtk.py:110
msgid "Light"
msgstr "Claro"

#: speedgtk.py:111
msgid "Dark"
msgstr "Oscuro"

#: speedgtk.py:250
msgid "Italian"
msgstr "Italiano"

#: speedgtk.py:251
msgid "English"
msgstr "Inglés"

#: speedgtk.py:252
