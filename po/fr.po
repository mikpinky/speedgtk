msgstr "Meilleur téléchargement"

#: speedgtk.py:103
msgid "Best upload"
msgstr "Meilleur téléversement"

#: speedgtk.py:104
msgid "Best ping"
msgstr "Meilleur ping"

#: speedgtk.py:105
msgid "Best overall"
msgstr "Meilleur résultat global"

#: speedgtk.py:109 speedgtk.py:249
msgid "Same as the system"
msgstr "Comme le système"

#: speedgtk.py:110
msgid "Light"
msgstr "Clair"

#: speedgtk.py:111
msgid "Dark"
msgstr "Sombre"

#: speedgtk.py:250
msgid "Italian"
msgstr "Italien"

#: speedgtk.py:251
msgid "English"
msgstr "Anglais"

