msgstr "Miglior ping"

#: speedgtk.py:105
msgid "Best overall"
msgstr "Migliore in assoluto"

#: speedgtk.py:109 speedgtk.py:249
msgid "Same as the system"
msgstr "Come il sistema"

#: speedgtk.py:110
msgid "Light"
msgstr "Chiaro"

#: speedgtk.py:111
msgid "Dark"
msgstr "Scuro"

