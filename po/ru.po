#: speedgtk.py:101
msgid "Sort by date (default)"
msgstr "Сортировать по дате (по умолчанию)"

#: speedgtk.py:102
msgid "Best download"
msgstr "Лучшая загрузка"

#: speedgtk.py:103
msgid "Best upload"
msgstr "Лучшая отдача"

#: speedgtk.py:104
msgid "Best ping"
msgstr "Лучший пинг"

#: speedgtk.py:105
msgid "Best overall"
msgstr "Лучший общий результат"

#: speedgtk.py:109 speedgtk.py:249
msgid "Same as the system"
msgstr "Как в системе"

#: speedgtk.py:110
msgid "Light"
msgstr "Светлая"

#: speedgtk.py:111
msgid "Dark"
msgstr "Тёмная"

#: speedgtk.py:250
msgid "Italian"
msgstr "Итальянский"

#: speedgtk.py:251
msgid "English"
msgstr "Английский"

