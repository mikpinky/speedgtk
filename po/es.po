msgstr "Iniciando…"

#: speedgtk.py:3048
msgid "not available"
msgstr "no disponible"

#: speedgtk.py:3091
msgid "Test started…"
msgstr "Prueba iniciada…"

#: speedgtk.py:3096
msgid "Measuring ping…"
msgstr "Midiendo el ping…"

#: speedgtk.py:3108
msgid "Download…"
msgstr "Descarga…"

#: speedgtk.py:3108
msgid "Upload…"
msgstr "Subida…"

#: speedgtk.py:3144
msgid "Completed"
msgstr "Completada"

#: speedgtk.py:3198 speedgtk.py:3200
msgid "Test cancelled"
msgstr "Prueba cancelada"

#: speedgtk.py:3205 speedgtk.py:3215
msgid "Error"
msgstr "Error"

#: speedgtk.py:3213
