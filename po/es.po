#: speedgtk.py:223
msgid "Too many tests in a short time"
msgstr "Demasiadas pruebas en poco tiempo"

#: speedgtk.py:225
msgid "Ookla is temporarily limiting this connection because too many tests were run in a short time. Wait a few minutes before repeating it."
msgstr "Ookla está limitando temporalmente esta conexión porque se han hecho demasiadas pruebas en poco tiempo. Espera unos minutos antes de repetirla."

#: speedgtk.py:231
msgid "No test server available"
msgstr "No hay servidores de prueba disponibles"

#: speedgtk.py:233
msgid "Ookla returned no usable server. Refresh the list, or pick a different server, and try again."
msgstr "Ookla no ha devuelto ningún servidor utilizable. Actualiza la lista o elige otro servidor y vuelve a intentarlo."

#: speedgtk.py:239
msgid "Cannot reach Ookla's servers"
msgstr "No se puede acceder a los servidores de Ookla"

#: speedgtk.py:241
msgid "The configuration service could not be reached. Check that the connection is working and that no proxy or firewall is blocking it."
msgstr "No se pudo contactar con el servicio de configuración. Comprueba que la conexión funciona y que ningún proxy o cortafuegos la bloquea."

#: speedgtk.py:247 speedgtk.py:252
msgid "Name resolution failed"
msgstr "Fallo en la resolución de nombres"

#: speedgtk.py:248 speedgtk.py:253
msgid "The server name could not be resolved: this usually points at a DNS problem."
msgstr "No se pudo resolver el nombre del servidor: suele ser un problema de DNS."

#: speedgtk.py:257
msgid "The connection timed out"
msgstr "Se agotó el tiempo de conexión"

#: speedgtk.py:258
msgid "The test server did not answer in time. It may be overloaded: try another one."
msgstr "El servidor de prueba no respondió a tiempo. Puede estar sobrecargado: prueba con otro."

#: speedgtk.py:262 speedgtk.py:267 speedgtk.py:272
msgid "Cannot connect to the test server"
msgstr "No se puede conectar con el servidor de prueba"

#: speedgtk.py:263 speedgtk.py:268 speedgtk.py:273
msgid "The connection to the chosen server could not be opened. Try another server."
msgstr "No se pudo abrir la conexión con el servidor elegido. Prueba con otro servidor."

#: speedgtk.py:277
msgid "Request refused by the server"
msgstr "Solicitud rechazada por el servidor"

#: speedgtk.py:278
msgid "The test server refused the request. Try a different server."
msgstr "El servidor de prueba rechazó la solicitud. Prueba con otro servidor."

#: speedgtk.py:282
msgid "Test interrupted"
msgstr "Prueba interrumpida"

#: speedgtk.py:283
msgid "The test ended early. Check that the connection stayed up."
msgstr "La prueba terminó antes de tiempo. Comprueba que la conexión se mantuvo activa."

#: speedgtk.py:296
msgid "speedtest reported an unspecified error"
msgstr "speedtest informó de un error no especificado"

