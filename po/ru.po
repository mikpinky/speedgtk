#: speedgtk.py:223
msgid "Too many tests in a short time"
msgstr "Слишком много тестов за короткое время"

#: speedgtk.py:225
msgid "Ookla is temporarily limiting this connection because too many tests were run in a short time. Wait a few minutes before repeating it."
msgstr "Ookla временно ограничивает это подключение, потому что за короткое время было запущено слишком много тестов. Подождите несколько минут."

#: speedgtk.py:231
msgid "No test server available"
msgstr "Нет доступных тестовых серверов"

#: speedgtk.py:233
msgid "Ookla returned no usable server. Refresh the list, or pick a different server, and try again."
msgstr "Ookla не вернула ни одного пригодного сервера. Обновите список или выберите другой сервер и попробуйте снова."

#: speedgtk.py:239
msgid "Cannot reach Ookla's servers"
msgstr "Серверы Ookla недоступны"

#: speedgtk.py:241
msgid "The configuration service could not be reached. Check that the connection is working and that no proxy or firewall is blocking it."
msgstr "Не удалось связаться со службой конфигурации. Проверьте, работает ли подключение и не блокирует ли его прокси или брандмауэр."

#: speedgtk.py:247 speedgtk.py:252
msgid "Name resolution failed"
msgstr "Не удалось разрешить имя"

#: speedgtk.py:248 speedgtk.py:253
msgid "The server name could not be resolved: this usually points at a DNS problem."
msgstr "Имя сервера не удалось разрешить: обычно это проблема DNS."

#: speedgtk.py:257
msgid "The connection timed out"
msgstr "Время ожидания подключения истекло"

#: speedgtk.py:258
msgid "The test server did not answer in time. It may be overloaded: try another one."
msgstr "Тестовый сервер не ответил вовремя. Возможно, он перегружен: попробуйте другой."

#: speedgtk.py:262 speedgtk.py:267 speedgtk.py:272
msgid "Cannot connect to the test server"
msgstr "Не удалось подключиться к тестовому серверу"

#: speedgtk.py:263 speedgtk.py:268 speedgtk.py:273
msgid "The connection to the chosen server could not be opened. Try another server."
msgstr "Не удалось открыть подключение к выбранному серверу. Попробуйте другой сервер."

#: speedgtk.py:277
msgid "Request refused by the server"
msgstr "Сервер отклонил запрос"

#: speedgtk.py:278
msgid "The test server refused the request. Try a different server."
msgstr "Тестовый сервер отклонил запрос. Попробуйте другой сервер."

#: speedgtk.py:282
msgid "Test interrupted"
msgstr "Тест прерван"

#: speedgtk.py:283
msgid "The test ended early. Check that the connection stayed up."
msgstr "Тест завершился раньше времени. Проверьте, не пропадало ли подключение."

#: speedgtk.py:296
msgid "speedtest reported an unspecified error"
msgstr "speedtest сообщил о неуточнённой ошибке"

