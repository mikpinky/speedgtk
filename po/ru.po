msgstr "Загрузка списка…"

#: speedgtk.py:2697
msgid "Could not load the servers"
msgstr "Не удалось загрузить серверы"

#: speedgtk.py:2704
#, python-brace-format
msgid "Refresh the server list — nearby: {count}"
msgstr "Обновить список серверов — рядом: {count}"

#: speedgtk.py:2723 speedgtk.py:3176
msgid "id"
msgstr "ID"

#: speedgtk.py:2738 speedgtk.py:2739
msgid "Automatic"
msgstr "Автоматически"

#: speedgtk.py:2741
#, python-brace-format
msgid "Last one: {server}"
msgstr "Последний: {server}"

#: speedgtk.py:2743
msgid "Picked by speedtest, by latency"
msgstr "Выбирает speedtest, по задержке"

#: speedgtk.py:2782
msgid "Ignored: a manual ID is set"
msgstr "Не учитывается: задан ID вручную"

#: speedgtk.py:2802
msgid "The manual server ID must be a number"
msgstr "ID сервера, заданный вручную, должен быть числом"

#: speedgtk.py:2817
msgid "Cancelling…"
msgstr "Отмена…"

#: speedgtk.py:2841
msgid "Cannot start speedtest"
msgstr "Не удалось запустить speedtest"

#: speedgtk.py:2852
msgid "Repeat test"
msgstr "Повторить тест"

#: speedgtk.py:2867
msgid "Starting…"
msgstr "Запуск…"

#: speedgtk.py:3048
msgid "not available"
msgstr "недоступно"

#: speedgtk.py:3091
msgid "Test started…"
msgstr "Тест запущен…"

#: speedgtk.py:3096
msgid "Measuring ping…"
msgstr "Измерение пинга…"

#: speedgtk.py:3108
msgid "Download…"
msgstr "Скачивание…"

#: speedgtk.py:3108
msgid "Upload…"
msgstr "Отправка…"

#: speedgtk.py:3144
msgid "Completed"
msgstr "Завершено"

#: speedgtk.py:3198 speedgtk.py:3200
msgid "Test cancelled"
msgstr "Тест отменён"

#: speedgtk.py:3205 speedgtk.py:3215
msgid "Error"
msgstr "Ошибка"

#: speedgtk.py:3213
#, python-brace-format
msgid "speedtest exited with code {code}"
msgstr "speedtest завершился с кодом {code}"

#: speedgtk.py:3229
msgid "Details"
msgstr "Подробности"

#: speedgtk.py:3235
msgid "speedtest error"
msgstr "Ошибка speedtest"

#: speedgtk.py:3236
msgid "Close"
msgstr "Закрыть"

#: speedgtk.py:3280
msgid ""
"Usage: speedgtk.py [options]\n"
"\n"
"  --plain     start with the classic, label-only GNOME interface\n"
"  --accent    use the theme accent color instead of Ookla's colors\n"
"  -h, --help  show this message\n"
"\n"
"Both options apply to this run only; the persistent settings live in\n"
"Preferences (Ctrl+,). Test history: Ctrl+H.\n"
msgstr ""
"Использование: speedgtk.py [параметры]\n"
"\n"
"  --plain     запустить классический интерфейс GNOME, только текст\n"
"  --accent    использовать акцентный цвет темы вместо цветов Ookla\n"
"  -h, --help  показать это сообщение\n"
"\n"
"Оба параметра действуют только для этого запуска; постоянные настройки —\n"
"в Параметрах (Ctrl+,). История тестов: Ctrl+H.\n"

