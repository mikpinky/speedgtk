msgstr "Запуск…"

#: speedgtk.py:2959
msgid "not available"
msgstr "недоступно"

#: speedgtk.py:3002
msgid "Test started…"
msgstr "Тест запущен…"

#: speedgtk.py:3007
msgid "Measuring ping…"
msgstr "Измерение пинга…"

#: speedgtk.py:3019
msgid "Download…"
msgstr "Скачивание…"

#: speedgtk.py:3019
msgid "Upload…"
msgstr "Отправка…"

#: speedgtk.py:3059
msgid "Completed"
msgstr "Завершено"

#: speedgtk.py:3113 speedgtk.py:3115
msgid "Test cancelled"
msgstr "Тест отменён"

